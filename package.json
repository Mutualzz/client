{
  "name": "@mutualzz/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**",
    "dist"
  ],
  "scripts": {
    "build": "pnpm typecheck && bunchee",
    "dev": "bunchee --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@mutualzz/bitfield": "workspace:*",
    "@mutualzz/types": "workspace:*",
    "@mutualzz/ui-core": "workspace:*",
    "@mutualzz/validators": "workspace:*",
    "chroma-js": "^3.1.2",
    "dayjs": "^1.11.13",
    "imurmurhash": "^0.1.4",
    "markdown-it": "^14.2.0",
    "mobx": "^6.16.1",
    "mobx-persist-store": "^1.1.8",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@mutualzz/eslint-config": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/pako": "^2.0.3",
    "bunchee": "^6.10.0",
    "eslint": "^10.8.0"
  }
}
